require "rake/clean"

CLEAN.include("../QR.*")
CLEAN.include("../qr.*")
CLEAN.include("../QR$*")
CLEAN.include("../QR")
CLEAN.include("../qr")
CLEAN.include("../QR2.aj")
CLEAN.include("../QRMUMPS.*")
CLEAN.include("../QR_ec*")
CLEAN.include("../qr_mercury*")
CLEAN.include("../qrkoka")
CLEAN.include("../qrchpl")
CLEAN.include("../qrroc")
CLEAN.include("../qr_austral")
CLEAN.include("../README.md")
CLEAN.include("../LANGUAGES.md")
CLEAN.include("../Makefile")
CLEAN.include("../Dockerfile")
CLEAN.include("../.github/workflows/main.yml")

LIBS = %w(
  code-gen.rb
  code-gen-pool.rb
  lazyk-boot.dat
  blc-boot.dat
  grass-boot.dat
  malbolge-boot.dat
)

file "lazyk-boot.dat" => "lazyk-boot.dat.gen.rb" do
  ruby "lazyk-boot.dat.gen.rb"
end

file "blc-boot.dat" => "blc-boot.dat.gen.rb" do
  ruby "blc-boot.dat.gen.rb"
end

file "grass-boot.dat" => "grass-boot.dat.gen.rb" do
  ruby "grass-boot.dat.gen.rb"
end

file "malbolge-boot.dat" => "malbolge-boot.dat.gen.py" do
  sh "python3", "malbolge-boot.dat.gen.py"
end

file "../QR.aj" => ["gen-aj.rb", "engine_body.java", *LIBS] do
  ruby "gen-aj.rb"
end

file "../README.md" => ["README.md.gen.rb", "../QR.aj", *LIBS] do
  ruby "README.md.gen.rb"
end

file "../LANGUAGES.md" => ["LANGUAGES.md.gen.rb", *LIBS] do
  ruby "LANGUAGES.md.gen.rb"
end

file "../Makefile" => ["Makefile.gen.rb", *LIBS] do
  ruby "Makefile.gen.rb"
end

file "../.github/workflows/main.yml" => ["dot.github.workflows.main.yml.gen.rb", *LIBS] do
  ruby "dot.github.workflows.main.yml.gen.rb"
end

file "../Dockerfile" => ["Dockerfile.gen.rb", *LIBS, *Dir["extra-installs/*.txt"].sort] do
  ruby "Dockerfile.gen.rb"
end

task :rom_guard => "../QR.aj" do
  ruby "vm-exec.rb"
end

task :test => :rom_guard do
  ruby "test.rb"
end

task :default => %w(
  ../QR.aj
  ../README.md
  ../LANGUAGES.md
  ../Makefile
  ../.github/workflows/main.yml
  ../Dockerfile
)

task "../SHA256SUMS" => ["SHA256SUMS.gen.rb", *LIBS] do
  ruby "SHA256SUMS.gen.rb"
end

task :run => :default do
  sh "make -C .."
end

task :gen => [:run, "../SHA256SUMS"]
