static final java.nio.charset.Charset U=java.nio.charset.StandardCharsets.UTF_8;static byte[]D;static int P;static String E;static int ri(){int v=0,k=0,b;do{b=D[P++]&255;v|=(b&127)<<k;
k+=7;}while((b&128)!=0);return v;}static String rs(){int n=ri();String r=new String(D,P,n,U);P+=n;return r;}static StringBuilder sb(){return new StringBuilder();}static StringBuilder sb(String s){
return new StringBuilder(s);}static ArrayList<String>al(){return new ArrayList<String>();}static Matcher mt(String p,String s){return Pattern.compile(p,Pattern.DOTALL).matcher(s);}static void byt(StringBuilder r,byte[]b,int n){
