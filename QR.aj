if(j<0){l.add(s.substring(i));break;}l.add(s.substring(i,j+1));i=j+1;}return l.toArray(new String[0]);}static String chomp(String s){return s.endsWith("\n")?s.substring(0,s.length()-1):s;}
static String bsl(String s,String a,String z){Matcher m=Pattern.compile("(?:\\\\\\\\)+").matcher(s);StringBuffer r=new StringBuffer();while(m.find()){m.appendReplacement(r,Matcher.quoteReplacement(a+(m.group().length()/2)+z));}
