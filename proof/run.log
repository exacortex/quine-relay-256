ecp -c QR_ec.main.ec -o QR_ec.main.sym
ecc -c QR_ec.main.ec -o QR_ec.main.c
gcc -std=gnu17 -w -o QR_ec QR_ec.c QR_ec.main.c -lecereCOM
./QR_ec > QR.vala

###########################
##  178: Vala -> Velato  ##
###########################

valac QR.vala
/usr/local/share/quine-relay/QR.vala.c: In function '_vala_main':
/usr/local/share/quine-relay/QR.vala.c:220:25: warning: trigraph '??/' ignored, use '-trigraphs' to enable [-Wtrigraphs]
  220 | "D//F/48//E/A5//D/4://C/??//B/07//A/9@AA//@AA/33//?/>>//>/=://=/@AD@AD@" \
./QR > QR.mid

##############################
##  179: Velato -> PARI/GP  ##
##############################

mono vendor/local/bin/Vlt.exe /s QR.mid
WARNING: The runtime version supported by this application is unavailable.
Using default runtime: v4.0.30319
mono QR.exe > QR.gp

################################
##  180: PARI/GP -> Mustache  ##
################################

gp -f -q QR.gp > QR.mustache

#############################
##  181: Mustache -> NASM  ##
#############################

mustache QR.mustache QR.mustache > QR.asm

########################
##  182: NASM -> Roc  ##
########################

nasm -felf QR.asm
ld -m elf_i386 -o QR QR.o
./QR > QR.roc

##########################
##  183: Roc -> Effekt  ##
##########################

roc build --output qrroc QR.roc
[1;32m0[0m errors and [1;32m0[0m warnings found in 320 ms while successfully building:

    qrroc
./qrroc > QR.effekt
rm -f qrroc

###########################
##  184: Effekt -> Inko  ##
###########################

rm -rf qr_effekt_out
effekt --backend js --out qr_effekt_out QR.effekt > QR.inko
