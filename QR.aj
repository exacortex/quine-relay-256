i<n;i++){if(i>0)r.append(i%120==0?'\n':' ');r.append(String.format("%02x",b[i]&255));}}static String procs(ArrayList<String>ac,int sz,String hdr,String pp,String pm,String pe,String mid,String cp,String end,int w){
StringBuilder r=sb(hdr);int g=(ac.size()+sz-1)/sz;for(int i=0;i<g;i++){if(i>0&&w>=0)r.append('\n');r.append(pp).append(i).append(pm);int e=Math.min(ac.size(),(i+1)*sz),cl=0;boolean fl=true;
for(int j=i*sz;j<e;j++){String st=ac.get(j);if(w>0&&!fl&&cl+st.length()<w){r.append(st);cl+=st.length();}else{if(!fl)r.append('\n');r.append(st);cl=st.length();fl=false;}}r.append(pe).append(w==4000?i+";":"");}
r.append(mid);for(int i=0;i<g;i++){if(w>=0&&i>0&&i%20==0)r.append('\n');r.append(cp).append(i).append(w<0?"\n":";");}return r.append(end).toString();}static String esc(String s){StringBuilder r=sb();
for(int i=0;i<s.length();i++){char c=s.charAt(i);if(c=='\\')r.append("\\\\");else if(c=='"')r.append("\\\"");else if(c=='\n')r.append("\\n");else r.append(c);}return r.toString();}static String dbl(String s,char q){
StringBuilder r=sb();for(int i=0;i<s.length();i++){char c=s.charAt(i);if(c==q)r.append(q);r.append(c);}return r.toString();}static String rep(String s,String[]k,String[]v){if(k.length==0)return s;
StringBuilder r=sb();int n=s.length(),m=k.length;for(int i=0;i<n;){boolean hit=false;for(int j=0;j<m;j++){if(s.startsWith(k[j],i)){r.append(v[j]);i+=k[j].length();hit=true;break;}}if(!hit)r.append(s.charAt(i++));}
return r.toString();}static String xf(String s,int f){if((f&262144)!=0)s=chomp(s);if((f&1)!=0)s=esc(s);if((f&2)!=0)s=dbl(s,'"');if((f&4)!=0)s=dbl(s,'\'');if((f&8)!=0)s=dbl(s,'`');if((f&48)!=0){
char q=(f&16)!=0?'"':'\'';StringBuilder r=sb();for(int i=0;i<s.length();i++){char c=s.charAt(i);if(c=='\\'||c==q)r.append('\\');r.append(c);}s=r.toString();}if((f&64)!=0)s=s.replace("\t","\\t");
if((f&128)!=0)s=s.replace("\r","\\r");if((f&256)!=0)s=s.replace("$","\\$");if((f&512)!=0)s=s.replace("%","\\%");if((f&1024)!=0)s=s.replace("%","%%");if((f&2048)!=0)s=s.replace("#","\\#");
if((f&4096)!=0)s=s.replace("?","\\?");if((f&8192)!=0)s=s.replace("'","\\'");if((f&16384)!=0)s=s.replace("{","{{").replace("}","}}");if((f&32768)!=0)s=s.replace("{","\\{").replace("}","\\}");
if((f&2293760)!=0){StringBuilder r=sb();for(int i=0;i<s.length();i++){char c=s.charAt(i);if((f&65536)!=0&&(c<32||c==127))r.append(String.format("\\x%02x",(int)c));else if((f&131072)!=0&&(c<10||(c>10&&c<32)||c==96||c==127))r.append(String.format("\\%03o",(int)c));
else if((f&2097152)!=0&&c>127)r.append(String.format("\\u%04x",(int)c));else r.append(c);}s=r.toString();}if((f&524288)!=0){StringBuilder r=sb();for(byte b:s.getBytes(U)){int u=b&255;
r.append(u>=128?String.format("\\x%02x",u):String.valueOf((char)u));}s=r.toString();}if((f&4194304)!=0){StringBuilder r=sb();for(int i=0;i<s.length();){int cp=s.codePointAt(i);if(cp>127)r.append("\\u{").append(Integer.toHexString(cp)).append('}');
