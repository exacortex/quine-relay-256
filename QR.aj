static final java.nio.charset.Charset U=java.nio.charset.StandardCharsets.UTF_8;static byte[]D;static int P;static String E;static int ri(){int v=0,k=0,b;do{b=D[P++]&255;v|=(b&127)<<k;
k+=7;}while((b&128)!=0);return v;}static String rs(){int n=ri();String r=new String(D,P,n,U);P+=n;return r;}static StringBuilder sb(){return new StringBuilder();}static StringBuilder sb(String s){
return new StringBuilder(s);}static ArrayList<String>al(){return new ArrayList<String>();}static Matcher mt(String p,String s){return Pattern.compile(p,Pattern.DOTALL).matcher(s);}static void byt(StringBuilder r,byte[]b,int n){
for(int i=0;i<n;i++){if(i%32==0){if(i>0)r.append('\n');r.append(" .byt ");}else r.append(',');r.append(i<b.length?(b[i]&255):0);}}static String procs(ArrayList<String>ac,int sz,String hdr,String pp,String pm,String pe,String mid,String cp,String end,int w){
StringBuilder r=sb(hdr);int g=(ac.size()+sz-1)/sz;for(int i=0;i<g;i++){if(i>0&&w>=0)r.append('\n');r.append(pp).append(i).append(pm);int e=Math.min(ac.size(),(i+1)*sz),cl=0;boolean fl=true;
for(int j=i*sz;j<e;j++){String st=ac.get(j);if(w>0&&!fl&&cl+st.length()<w){r.append(st);cl+=st.length();}else{if(!fl)r.append('\n');r.append(st);cl=st.length();fl=false;}}r.append(pe).append(w==4000?i+";":"");}
