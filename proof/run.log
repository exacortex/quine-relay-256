./QR > QR.octave

############################
##  191: Octave -> OCaml  ##
############################

mv QR.m QR.m.bak
octave -qf QR.octave > QR.ml
mv QR.m.bak QR.m

############################
##  192: OCaml -> Chapel  ##
############################

ocaml QR.ml > QR.chpl

###########################
##  193: Chapel -> Pony  ##
###########################

chpl -o qrchpl QR.chpl
./qrchpl > QR.pony

###########################
##  194: Pony -> Perl 6  ##
###########################

mkdir -p qrpony
cp QR.pony qrpony/main.pony
ponyc -V0 -b qrpony.out -o . qrpony
./qrpony.out > QR.pl6

##############################
##  195: Perl 6 -> Mercury  ##
##############################

perl6 QR.pl6 > qr_mercury.m

############################
##  196: Mercury -> Odin  ##
############################

mmc --make qr_mercury > /dev/null
Making Mercury/int3s/qr_mercury.int3
Making Mercury/ints/qr_mercury.int
Making Mercury/cs/qr_mercury.c
Making Mercury/os/qr_mercury.o
Making qr_mercury
./qr_mercury > QR.odin

###########################
##  197: Odin -> Arturo  ##
###########################

odin run QR.odin -file > QR.art

###############################
##  198: Arturo -> PicoLisp  ##
###############################

arturo QR.art < /dev/null > QR.l

###############################
##  199: PicoLisp -> Elvish  ##
###############################

pil QR.l > QR.elv

#############################
##  200: Elvish -> Lean 4  ##
#############################

elvish QR.elv > QR.lean

##########################
##  201: Lean 4 -> ///  ##
##########################

lean --run QR.lean > QR.slashes

########################
##  202: /// -> CJam  ##
########################

ruby vendor/slashes.rb QR.slashes > QR.cjam

##############################
##  203: CJam -> Underload  ##
##############################

java -jar /opt/cjam/cjam-0.6.5.jar QR.cjam > QR.ul

####################################
##  204: Underload -> Brain-Flak  ##
####################################

ruby vendor/underload.rb QR.ul > QR.bflk

##################################
##  205: Brain-Flak -> SNOBOL4  ##
##################################

craneflak -A QR.bflk > QR.sno

#############################
##  206: SNOBOL4 -> Klong  ##
#############################

snobol4 -b QR.sno > QR.kg

###########################
##  207: Klong -> Seed7  ##
###########################

kg QR.kg < /dev/null > QR.sd7

################################
##  208: Seed7 -> GolfScript  ##
################################

s7 -q QR.sd7 > QR.gs

#####################################
##  209: GolfScript -> G-Portugol  ##
#####################################

ruby vendor/golfscript.rb QR.gs > QR.gpt

################################
##  210: G-Portugol -> Grass  ##
################################

mv QR.c QR.c.bak
gpt -t QR.c QR.gpt
gcc -o QR QR.c
./QR > QR.grass
mv QR.c.bak QR.c

###########################
##  211: Grass -> AFNIX  ##
###########################

ruby vendor/grass.rb QR.grass > QR.als

###########################
##  212: AFNIX -> Aheui  ##
###########################

LANG=C LD_LIBRARY_PATH=/usr/lib/afnix axi QR.als > QR.aheui

#########################
##  213: Aheui -> PHP  ##
#########################

ruby vendor/aheui.rb QR.aheui > QR.php

########################
##  214: PHP -> Piet  ##
########################

php QR.php > QR.png

###################################
##  215: Piet -> Promela (Spin)  ##
###################################

npiet QR.png > QR.pr

###################################
##  216: Promela (Spin) -> Rail  ##
###################################

spin -T QR.pr > QR.rail

###########################
##  217: Rail -> Kipple  ##
