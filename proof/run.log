##  187: GNU APL -> Vale  ##
############################

apl --script --OFF -s -f QR.apl > QR.vale

#########################
##  188: Vale -> Pawn  ##
#########################

rm -rf qr_vale_out
valec build qr=QR.vale --output_dir qr_vale_out > /dev/null
./qr_vale_out/main > QR.pawn
rm -rf qr_vale_out

################################
##  189: Pawn -> Objective-C  ##
################################

pawncc -C64 QR.pawn -oQR.amx > /dev/null
pawnrun QR.amx > QR.m
rm -f QR.amx

##################################
##  190: Objective-C -> Octave  ##
##################################

gcc -o QR QR.m
