./QR > QR.pl

#############################
##  229: Perl 5 -> Nickle  ##
#############################

perl QR.pl > QR.5c

###################################
##  230: Nickle -> rep (librep)  ##
###################################

nickle QR.5c > QR.rep

##################################
##  231: rep (librep) -> Grain  ##
##################################

rep QR.rep > QR.gr

#########################
##  232: Grain -> HOC  ##
#########################

grain QR.gr > QR.hoc

########################
##  233: HOC -> Flix  ##
########################

/usr/lib/plan9/bin/hoc QR.hoc > QR.flix

#########################
##  234: Flix -> Hope  ##
#########################

java -XX:TieredStopAtLevel=1 -jar /opt/flix/flix.jar QR.flix > QR.hop

############################
##  235: Hope -> Austral  ##
############################

hope -f QR.hop > QR.aum

################################
##  236: Austral -> 6502 asm  ##
################################

austral compile QR.aum --entrypoint=QR:main --output=qr_austral
./qr_austral > QR.s65
rm -f qr_austral

###############################
##  237: 6502 asm -> Uxntal  ##
###############################

xa -o QR.o65 QR.s65
sim65 QR.o65 > QR.tal
rm -f QR.o65

##############################
##  238: Uxntal -> Z80 asm  ##
##############################

uxnasm QR.tal QR.rom
Assembled QR.rom in 56.12kb(88.43% used), 6 labels, 0 macros.
uxncli QR.rom > QR.z80
Loaded QR.rom
rm -f QR.rom

##############################
##  239: Z80 asm -> Scilab  ##
##############################

z80asm QR.z80 -o qr.com
chmod a+r qr.com
if [ $(id -u) = 0 ]; then setpriv --reuid=nobody --regid=nogroup --clear-groups tnylpo -b qr.com; else tnylpo -b qr.com; fi < /dev/null > QR.sci
rm -f qr.com

##########################
##  240: Scilab -> sed  ##
##########################

scilab-cli -nb -f QR.sci > QR.sed

###############################
##  241: sed -> Shakespeare  ##
###############################

sed -E -f QR.sed QR.sed > QR.spl

##################################
##  242: Shakespeare -> S-Lang  ##
##################################

spl2c < QR.spl > QR.spl.c
gcc -z muldefs -o QR -I ./vendor/local/include -L ./vendor/local/lib QR.spl.c -lspl -lm
./QR > QR.sl

##########################
##  243: S-Lang -> ksh  ##
##########################

slsh QR.sl > QR.ksh

##########################
##  244: ksh -> Lazy K  ##
##########################

ksh QR.ksh > QR.lazy

#################################
##  245: Lazy K -> LiveScript  ##
#################################

ulimit -s unlimited && lazyk QR.lazy > QR.ls

####################################
##  246: LiveScript -> BeanShell  ##
####################################

lsc QR.ls > QR.bsh

#################################
##  247: BeanShell -> Befunge  ##
#################################

bsh QR.bsh > QR.bef
stty: standard input: Inappropriate ioctl for device
make: [Makefile:2139: QR.bef] Error 1 (ignored)

############################
##  248: Befunge -> BLC8  ##
############################

cfunge QR.bef > QR.Blc

##############################
##  249: BLC8 -> Brainfuck  ##
##############################

ruby vendor/blc.rb < QR.Blc > QR.bf

################################
##  250: Brainfuck -> Python  ##
################################

ruby vendor/bf.rb QR.bf > QR.py

##########################################
##  251: Python -> Malbolge Unshackled  ##
##########################################

python3 QR.py > QR.mb

#####################################
##  252: Malbolge Unshackled -> R  ##
#####################################

unshackled QR.mb < /dev/null > QR.R

########################
##  253: R -> Ratfor  ##
########################

R --slave -f QR.R > QR.ratfor

#########################
##  254: Ratfor -> rc  ##
#########################

ratfor -o QR.ratfor.f QR.ratfor
gfortran -o QR QR.ratfor.f
./QR > QR.rc

#######################
##  255: rc -> REXX  ##
#######################

rc QR.rc > QR.rexx

#########################
##  256: REXX -> Ruby  ##
#########################

rexx ./QR.rexx > QR2.rb

