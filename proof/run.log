chmod +x qrkoka
./qrkoka > QR.st

######################################
##  141: GNU Smalltalk -> LLVM asm  ##
######################################

gst QR.st > QR.ll

################################
##  142: LLVM asm -> LOLCODE  ##
################################

llvm-as QR.ll
lli QR.bc > QR.lol

###########################
##  143: LOLCODE -> Lua  ##
###########################

lci QR.lol > QR.lua

###############################
##  144: Lua -> Standard ML  ##
###############################

lua5.3 QR.lua > QR.sml

##################################
##  145: Standard ML -> Subleq  ##
##################################

polyc -o QR QR.sml
./QR > QR.sq

##########################
##  146: Subleq -> Boo  ##
##########################

ruby vendor/subleq.rb QR.sq > QR.boo

#########################
##  147: Boo -> CDuce  ##
#########################

booi QR.boo > QR.cd

#########################
##  148: CDuce -> TXR  ##
#########################

cduce QR.cd > QR.txrlisp

##############################
##  149: TXR -> JavaScript  ##
##############################

txr --lisp QR.txrlisp > QR.js

#############################
##  150: JavaScript -> Jq  ##
#############################

nodejs QR.js > QR.jq

#######################
##  151: Jq -> nesC  ##
#######################

jq -j -n -f QR.jq > QR.nc

############################
##  152: nesC -> Gravity  ##
############################

nescc -gcc=gcc-14 -o QR QR.nc
./QR > QR.gravity

##############################
##  153: Gravity -> Racket  ##
##############################

gravity -q QR.gravity > QR.rkt

#########################
##  154: Racket -> A+  ##
#########################

racket QR.rkt > QR.aplus.a

#########################
##  155: A+ -> Kotlin  ##
#########################

a+ QR.aplus.a > QR.kt 2> /dev/null < /dev/null

################################
##  156: Kotlin -> ARM64 asm  ##
################################

kotlinc QR.kt -include-runtime -d QR.jar
